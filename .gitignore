# .gitignore
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ===== 项目特定配置 =====

# Input 目录（存放源文件，不提交）
Input/
!Input/.gitkeep

# Output 目录 - 允许提交所有文件
# 注意：不要忽略 Output 目录
Output/
!Output/.gitkeep
!Output/*.xlsx
!Output/*.xls
!Output/*.xlsm
!Output/.progress.json

# 临时文件
*.tmp
*.temp
*.log
*.cache

# .gitignore
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 项目特定 - 不忽略 Input 目录下的文件
# Input/*.xlsx  # 注释掉，允许提交输入文件
# Input/*.xls   # 注释掉
# Input/*.xlsm  # 注释掉
!Input/.gitkeep

# 输出文件 - 允许提交
# Output/*.xlsx  # 注释掉，允许提交
# Output/*.xls   # 注释掉
!Output/.gitkeep
!Output/.progress.json  # 允许提交进度文件

# 临时文件
*.tmp
*.temp
*.log
